PORT=5000MONGO_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/<dbname>JWT_SECRET=your_jwt_secret_here# Roboflow Workflow modeROBOFLOW_API_KEY=# Example: https://detect.roboflow.com/workflows/<workspace>/<workflow-id># Make sure this URL points to an active workflow endpoint that accepts base64 image input.ROBOFLOW_URL=ROBOFLOW_CONFIDENCE_CONFIRMED=65ROBOFLOW_CONFIDENCE_LOW=35GEMINI_API_KEY=your_gemini_api_keyGEMINI_MODEL=gemini-2.0-flash# LLM provider config: auto | openrouter | geminiLLM_PROVIDER=autoOPENROUTER_API_KEY=OPENROUTER_MODEL=openai/gpt-4o-miniOPENROUTER_VISION_MODEL=google/gemini-2.0-flash-001OPENROUTER_SITE_URL=OPENROUTER_APP_NAME=Agri_MytraNEWS_API_KEY=your_news_api_key